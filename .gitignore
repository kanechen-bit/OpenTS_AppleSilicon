[Dd]ebug/
[Rr]elease/
/Run/*
!/Run/place_steam_build_here
*.obj
*.exe
*.dll
*.lib
*.res
*.ilk
*.map
*.exp

# MSVC intermediate files
*.aps
*.pdb
*.idb
*.pch

# CMake and Visual Studio 2022
[Bb]uild/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
*.sln
*.suo
*.user
*.vcxproj
*.vcxproj.*
.vs/

# Editors and language servers
*~
*.bak
*.swp
*.code-workspace
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/c_cpp_properties.clang.example.json
.history/
/.cache/
