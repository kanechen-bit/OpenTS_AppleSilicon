/compile_commands.json

# Python bytecode
__pycache__/
*.pyc

# Manual tooling temp snapshots (interrupted manage.py runs)
manual/data/.manual-check-*/
manual/data/.manual-generate-*/

# Agent worktrees, which are checkouts of this repository placed inside it
/.claude/worktrees/

# Working memory of the AI assistants used during the port. It is a record of
# how the work was done rather than part of it, and it is not this project's to
# publish.
/.workbuddy/

# ---------------------------------------------------------------------------
# Apple Silicon port additions
# ---------------------------------------------------------------------------

# The assembled application bundle. Rebuilt from source with
# tools/macos-app/make_app.sh; a signed binary has no place in the history and
# goes out as a release artifact instead.
/dist/

# Other build trees. [Bb]uild/ above covers only the default name, and these
# were separate directories during the port.
/build-*/
/out/

# A settings file lands in the source root when the engine is run from there
# rather than from Run/. It is per-machine state, not source, and the file the
# application ships is tools/macos-app/SUN.INI.
/SUN.INI

# Engine logs and dumps from a headless run in the source tree.
*.LOG
/opents_crash.txt

# Game data must never enter this repository. OpenTS supplies the engine, never
# the original assets, and Tiberian Sun's data files are Electronic Arts'
# property. This is a backstop, not the primary measure: nothing in the build
# needs these, and a stray one usually means a run was pointed at the install
# directory instead of a symlink farm.
*.MIX
*.mix
*.MAP
*.map
*.SND
*.SPR
*.CIF
*.PAL
*.INI.local

# Local scratch analysis scripts and their output, kept out of the tree so the
# diagnostic stays reproducible without its throwaway output checked in.
/analyze_black.py
/*.ppm
/black-*/

# Editor and OS droppings. .DS_Store is regenerated by Finder the moment the
# directory is opened, so ignoring it is the only way to keep it out.
.DS_Store
**/.DS_Store
